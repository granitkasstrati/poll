(version 1)

# HV nets to board edge
(rule "hv_to_edge" (condition "(A.NetClass == 'HV_PWR' || A.NetClass == 'HV_HC') && B.Type == 'Edge'")
   (constraint edge_clearance (min 2mm)))
# cold (isolated) side internally only needs normal spacing
(rule "cold_internal" (condition "A.NetClass == 'COLD' && B.NetClass == 'COLD'")
   (constraint clearance (min 0.2mm)))
# ACS724 primary: IP+ and IP- differ by milli-volts
(rule "acs724_primary" (condition "A.NetName == 'OUT_LA' && B.NetName == 'OUT_LF'")
   (constraint clearance (min 0.4mm)))
# hs_A: floating high-side gate-drive island
(rule "hs_A" (condition "(A.NetName == 'SW_A' || A.NetName == 'VB_A' || A.NetName == 'HO_A' || A.NetName == 'QAH_G') && (B.NetName == 'SW_A' || B.NetName == 'VB_A' || B.NetName == 'HO_A' || B.NetName == 'QAH_G')")
   (constraint clearance (min 0.3mm)))
# hs_B: floating high-side gate-drive island
(rule "hs_B" (condition "(A.NetName == 'SW_B' || A.NetName == 'VB_B' || A.NetName == 'HO_B' || A.NetName == 'QBH_G') && (B.NetName == 'SW_B' || B.NetName == 'VB_B' || B.NetName == 'HO_B' || B.NetName == 'QBH_G')")
   (constraint clearance (min 0.3mm)))
# unconnected (NC) IC pins float; they only need manufacturing clearance
(rule "nc_pins" (condition "A.Type == 'Pad' && A.NetName == ''")
   (constraint clearance (min 0.2mm)))
# pins inside one footprint (IC pin pitch, divider resistor ends, terminal blocks)
(rule "intra_J1" (condition "A.intersectsCourtyard('J1') && B.intersectsCourtyard('J1')")
   (constraint clearance (min 0.2mm)))
(rule "intra_F1" (condition "A.intersectsCourtyard('F1') && B.intersectsCourtyard('F1')")
   (constraint clearance (min 0.2mm)))
